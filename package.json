{
  "name": "elysia-typewriter",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "commit": "cz",
    "dev": "vite",
    "build": "pnpm type-check && pnpm build-only",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit",
    "lint": "pnpm lint-eslint && pnpm lint-stylelint",
    "lint-eslint": "eslint . --fix",
    "lint-stylelint": "stylelint ./**/*.{css,sass,scss} --fix --ignore-path .gitignore",
    "clean": "rimraf pnpm-lock.yaml node_modules dist",
    "release": "semantic-release",
    "svgo": "svgo -rf src"
  },
  "dependencies": {
    "@vueuse/core": "^10.1.2",
    "element-plus": "^2.14.5",
    "lodash": "^4.17.21",
    "pinia": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@aghap/semantic-release-gh-pages": "^2.0.9",
    "@antfu/eslint-config": "^9.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tsconfig/node22": "^22.0.0",
    "@types/lodash": "^4.14.194",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitejs/plugin-vue-jsx": "^5.0.0",
    "@vue/devtools-api": "^8.1.5",
    "@vue/tsconfig": "^0.4.0",
    "commitizen": "^4.3.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.0.0",
    "rimraf": "^5.0.5",
    "sass": "^1.58.3",
    "semantic-release": "^20.1.3",
    "stylelint": "^17.0.0",
    "stylelint-config-sass-guidelines": "^13.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "svgo": "^3.0.2",
    "ts-keycode-enum": "^1.0.6",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.0.0",
    "vue-tsc": "^3.0.0"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/github",
      [
        "@aghap/semantic-release-gh-pages",
        {
          "src": "dist",
          "ghpBranch": "gh-pages",
          "ghpPath": "/",
          "message": "chore(release): GitHub Pages release"
        }
      ]
    ]
  }
}
